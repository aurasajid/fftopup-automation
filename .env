# ============================================================
# FF TopUp Automation — Configuration
# ============================================================
# Restart the app after editing this file.
# ============================================================


# ------------------------------------------------------------
# TELEGRAM BOT
# ------------------------------------------------------------
TG_BOT_TOKEN=8866708427:AAEkrmOd1OfdBDS9eXet4ghmILIfe5mHIpw
TG_CHAT_ID=
TG_ALLOWED_USERS=


# ------------------------------------------------------------
# BROWSER MODE
# ------------------------------------------------------------
# true = hidden browser | false = visible browser (local dev)
HEADLESS=false

# true = full render (CSS + images) | false = plain text (fast, no CSS/images)
WEBRENDER=false

# Block tracker / analytics domains
BLOCK_TRACKERS=true

# Pre-resolve DNS + TLS for Garena & UniPin before launching Chromium
ENABLE_WARMUP=true


# ------------------------------------------------------------
# TIMEOUTS (milliseconds — 1000 = 1 second)
# ------------------------------------------------------------
TIMEOUT_NAV=60000
TIMEOUT_SHORT=45000
TIMEOUT_RESULT=90000


# ------------------------------------------------------------
# FIXED PAUSES (milliseconds)
# ------------------------------------------------------------
PAUSE_AFTER_PAGE=800
PAUSE_AFTER_UID=500
PAUSE_AFTER_LOGIN=200
PAUSE_AFTER_PROCEED=500
PAUSE_AFTER_DIAMOND=300
PAUSE_AFTER_TAB=300
PAUSE_AFTER_PROVIDER=300
PAUSE_AFTER_SERIAL=100
PAUSE_AFTER_PIN=100
PAUSE_BEFORE_CONFIRM=80


# ------------------------------------------------------------
# RESULT POLLING (milliseconds)
# ------------------------------------------------------------
# Normal poll interval used after the first 5 seconds
RESULT_POLL_INTERVAL=100
# Faster poll interval for the first 5 seconds after Confirm
RESULT_POLL_INTERVAL_FAST=50


# ------------------------------------------------------------
# TYPING SPEED (ms between keystrokes)
# ------------------------------------------------------------
TYPE_DELAY_UID=15
TYPE_DELAY_PIN=10


# ------------------------------------------------------------
# FALLBACK PACKAGE (used when pkg is missing in a request)
# ------------------------------------------------------------
FALLBACK_PACKAGE=25


# ------------------------------------------------------------
# BROWSER FINGERPRINT ROTATION
# ------------------------------------------------------------
# Rotate Chromium after this many seconds of idle (default: 5 minutes)
IDLE_ROTATE_SECONDS=300
# How often the background rotator checks idle state (seconds)
ROTATOR_INTERVAL=30


# ------------------------------------------------------------
# PLAYER NAME API (comma-separated, tried left→right)
# ------------------------------------------------------------
# {uid} is replaced by the sanitized UID.
# If a template has no &region=, PLAYER_API_REGION is appended.
PLAYER_API_URLS=https://ffnamecheck.vercel.app/info?uid={uid}
PLAYER_API_REGION=bd


# ------------------------------------------------------------
# DEVELOPER CREDIT (shown in the footer)
# ------------------------------------------------------------
DEV_NAME=S!XU
DEV_LINK=https://t.me/aura_sajid
DEV_LINK_TEXT=S!XU


# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
PORT=8000
